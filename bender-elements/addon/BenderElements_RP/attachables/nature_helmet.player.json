{
  "format_version": "1.10.0",
  "minecraft:attachable": {
    "description": {
      "identifier": "bender:nature_helmet.player",
      "item": {
        "bender:nature_helmet": "query.owner_identifier == 'minecraft:player'"
      },
      "materials": {
        "default": "armor",
        "enchanted": "armor_enchanted"
      },
      "textures": {
        "default": "textures/models/armor/nature_1",
        "enchanted": "textures/misc/enchanted_actor_glint"
      },
      "render_controllers": [
        "controller.render.armor"
      ],
      "geometry": {
        "default": "geometry.player.armor.helmet"
      },
      "scripts": {
        "parent_setup": "variable.helmet_layer_visible = 0.0;",
        "animate": [
          "offset"
        ]
      },
      "animations": {
        "offset": "animation.armor.helmet.offset"
      }
    }
  }
}
