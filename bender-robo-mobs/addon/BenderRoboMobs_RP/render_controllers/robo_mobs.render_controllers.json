{
  "format_version": "1.8.0",
  "render_controllers": {
    "controller.render.bender_robo": {
      "geometry": "Geometry.default",
      "materials": [
        {
          "*": "Material.default"
        }
      ],
      "textures": [
        "Texture.default"
      ]
    },
    "controller.render.bender_robo_warden": {
      "arrays": {
        "textures": {
          "Array.glow": [
            "Texture.default",
            "Texture.rage"
          ]
        }
      },
      "geometry": "Geometry.default",
      "materials": [
        {
          "*": "Material.default"
        }
      ],
      "textures": [
        "Array.glow[q.property('bender:rage') ? 1 : 0]"
      ]
    }
  }
}
