              "texture": "bender_minicars_light_red",
              "render_method": "opaque"
            }
          },
          "minecraft:light_emission": 10
        }
      },
      {
        "condition": "q.block_state('bender:light') == 2",
        "components": {
          "minecraft:material_instances": {
            "*": {
              "texture": "bender_minicars_light_green",
              "render_method": "opaque"
            }
          },
          "minecraft:light_emission": 12
        }
      }
    ]
  }
}
