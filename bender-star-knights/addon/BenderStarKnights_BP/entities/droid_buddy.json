{
  "format_version": "1.21.90",
  "minecraft:entity": {
    "description": {
      "identifier": "bender:droid_buddy",
      "is_spawnable": false,
      "is_summonable": true,
      "properties": {
        "bender:color": {
          "type": "int",
          "range": [
            0,
            7
          ],
          "default": 0,
          "client_sync": true
        }
      }
    },
    "component_groups": {
      "bender:tamed": {
        "minecraft:is_tamed": {},
        "minecraft:behavior.follow_owner": {
          "priority": 4,
          "speed_multiplier": 1.3,
          "start_distance": 6,
          "stop_distance": 2
        }
      }
    },
    "components": {
      "minecraft:type_family": {
        "family": [
          "bender_droid",
          "mob"
        ]
      },
      "minecraft:collision_box": {
        "width": 0.6,
        "height": 1.0
      },
      "minecraft:health": {
        "value": 30,
        "max": 30
      },
      "minecraft:movement": {
        "value": 0.32
      },
      "minecraft:movement.basic": {},
      "minecraft:navigation.walk": {
        "can_path_over_water": true,
        "avoid_water": true,
        "avoid_damage_blocks": true
      },
      "minecraft:jump.static": {},
      "minecraft:physics": {},
      "minecraft:pushable": {
        "is_pushable": true,
        "is_pushable_by_piston": true
      },
      "minecraft:breathable": {
        "total_supply": 15,
        "suffocate_time": 0,
        "breathes_water": true
      },
      "minecraft:nameable": {},
      "minecraft:persistent": {},
      "minecraft:healable": {
        "items": [
          {
            "item": "minecraft:iron_ingot",
            "heal_amount": 10
          }
        ]
      },
      "minecraft:damage_sensor": {
        "triggers": [
          {
            "cause": "fall",
            "deals_damage": "no"
          },
          {
            "on_damage": {
              "filters": {
                "test": "is_family",
                "subject": "other",
                "value": "player"
              }
            },
            "deals_damage": "no"
          }
        ]
      },
      "minecraft:tameable": {
        "probability": 1.0,
        "tame_items": [
          "minecraft:iron_ingot"
        ],
        "tame_event": {
          "event": "bender:on_tame",
          "target": "self"
        }
      },
      "minecraft:behavior.float": {
        "priority": 0
      },
      "minecraft:behavior.hurt_by_target": {
        "priority": 1,
        "entity_types": [
          {
            "filters": {
              "test": "is_family",
              "subject": "other",
              "operator": "!=",
              "value": "player"
            }
          }
        ]
      },
      "minecraft:behavior.random_stroll": {
        "priority": 7,
        "speed_multiplier": 0.8
      },
      "minecraft:behavior.look_at_player": {
        "priority": 8,
        "look_distance": 8
      },
      "minecraft:behavior.random_look_around": {
        "priority": 9
      }
    },
    "events": {
      "bender:on_tame": {
        "add": {
          "component_groups": [
            "bender:tamed"
          ]
        }
      }
    }
  }
}
