{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "bender:suit_glow",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/particle/bender_suit_particles"
      }
    },
    "components": {
